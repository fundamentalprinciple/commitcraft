# Server Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# ── Application ────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/commitcraft

# ── Session ─────────────────────────────────────────────────
SESSION_SECRET=change_me_to_a_long_random_string

# ── GitHub OAuth ────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ── Encryption (for GitHub access tokens at rest) ───────────
ENCRYPTION_KEY=32_char_hex_string_for_aes_256

# ── OpenAI-compatible LLM ───────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Gamification Reward Values (optional overrides) ──────────
REWARD_COMMIT_XP=10
REWARD_COMMIT_COINS=5
REWARD_PR_OPEN_XP=20
REWARD_PR_MERGED_XP=50
REWARD_PR_MERGED_COINS=25
REWARD_ISSUE_CLOSED_XP=15
REWARD_ISSUE_CLOSED_COINS=10
REWARD_REVIEW_XP=25
REWARD_RELEASE_XP=100
REWARD_RELEASE_COINS=50
